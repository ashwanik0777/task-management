// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  password      String
  role          String    // "ADMIN" or "INTERN"
  rollNumber    String?   @unique // For Interns: 222UCS001
  status        String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  avatarUrl     String?
  bio           String?
  skills        String?   // Comma separated skills
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignedTasks Task[]    @relation("AssignedTo")
  createdTasks  Task[]    @relation("CreatedBy")
  workSessions  WorkSession[] @relation("InternSessions")
  sessionReviews SessionReview[] @relation("SessionReviewsGiven")
  chatMessages  SessionChatMessage[] @relation("SessionMessagesSent")
  directChatsAsIntern DirectConversation[] @relation("DirectChatIntern")
  directChatsAsAdmin DirectConversation[] @relation("DirectChatAdmin")
  directMessages DirectMessage[] @relation("DirectMessageSender")
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Task {
  id             String    @id @default(uuid())
  title          String
  description    String
  priority       String    // "LOW", "MEDIUM", "HIGH"
  deadline       DateTime
  status         String    @default("PENDING") // "PENDING", "ACCEPTED", "DECLINED", "IN_PROGRESS", "PAUSED", "COMPLETED", "NO_RESPONSE"
  declineReason  String?
  sendEmail      Boolean   @default(false)
  
  assignedToId   String
  assignedTo     User      @relation("AssignedTo", fields: [assignedToId], references: [id])
  
  createdById    String
  createdBy      User      @relation("CreatedBy", fields: [createdById], references: [id])
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  timeLogs       TimeLog[]
  submissions    Submission[]
  feedback       String?   // Admin feedback for rejection
}

model Submission {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  type      String   // "IMAGE" or "LINK"
  url       String
  createdAt DateTime @default(now())
}

model TimeLog {
  id        String    @id @default(uuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id])
  startTime DateTime  @default(now())
  endTime   DateTime?
  type      String    // "WORK", "PAUSE"
}

model SiteStats {
  id        String   @id @default(uuid())
  views     Int      @default(0)
}

model WorkSession {
  id          String    @id @default(uuid())
  internId    String
  intern      User      @relation("InternSessions", fields: [internId], references: [id])
  status      String    @default("ACTIVE") // "ACTIVE", "COMPLETED"
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  summary     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  reviews     SessionReview[]
  messages    SessionChatMessage[]

  @@index([internId, status])
  @@index([startedAt])
}

model SessionReview {
  id         String      @id @default(uuid())
  sessionId  String
  session    WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User        @relation("SessionReviewsGiven", fields: [reviewerId], references: [id])
  note       String
  createdAt  DateTime    @default(now())

  @@index([sessionId, createdAt])
}

model SessionChatMessage {
  id         String      @id @default(uuid())
  sessionId  String
  session    WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User        @relation("SessionMessagesSent", fields: [senderId], references: [id])
  message    String
  createdAt  DateTime    @default(now())

  @@index([sessionId, createdAt])
}

model DirectConversation {
  id        String   @id @default(uuid())
  internId  String
  intern    User     @relation("DirectChatIntern", fields: [internId], references: [id])
  adminId   String
  admin     User     @relation("DirectChatAdmin", fields: [adminId], references: [id])
  adminClearedAt DateTime?
  internClearedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  DirectMessage[]

  @@unique([internId, adminId])
  @@index([internId])
  @@index([adminId])
}

model DirectMessage {
  id             String             @id @default(uuid())
  conversationId String
  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User               @relation("DirectMessageSender", fields: [senderId], references: [id])
  message        String
  reminderSentAt DateTime?
  createdAt      DateTime           @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}
